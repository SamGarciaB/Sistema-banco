# HSBCE-final — configuración de ejemplo
# Copia este archivo como .env en la raíz del proyecto y ajusta los valores.
# Este archivo de ejemplo sí se puede compartir; el .env real se queda fuera de Git.

APP_NAME="HSBCE-final - Demo"
# Entorno de ejecución: development, staging o production.
APP_ENV=development
APP_DEBUG=false
# Dirección local para las pruebas.
APP_URL=http://localhost
APP_TIMEZONE=America/Mexico_City

# Base de datos local
# En el servidor, configura un usuario propio con los permisos que necesita la app.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hsbc_worldcup
DB_USER=hsbc_app
DB_PASS=REEMPLAZAR_CON_UNA_PASSWORD_LOCAL

# Clave para firmar los tokens temporales del formulario.
# Genera una con: openssl rand -hex 32
HMAC_KEY=REEMPLAZAR_CON_64_CARACTERES_HEXADECIMALES

# Orígenes desde los que la API acepta solicitudes.
# En local puedes dejar estos dos; al desplegar, usa solo el dominio correspondiente.
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Turnstile de Cloudflare
# Crea un widget de prueba para localhost y coloca aquí sus claves.
# La Site Key también se usa en el cliente; la Secret Key se queda en el servidor.
TURNSTILE_SITE_KEY=REEMPLAZAR_CON_TU_SITE_KEY
TURNSTILE_SECRET=REEMPLAZAR_CON_TU_SECRET_KEY

# Nivel de detalle de los registros de la aplicación.
# Niveles disponibles: debug, info, notice, warning, error, critical.
LOG_LEVEL=debug
LOG_RETENTION_DAYS=30
